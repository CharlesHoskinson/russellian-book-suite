;; Project-wide clj-kondo configuration.
;;
;; The verifier projects use two pattern-matching DSLs whose pattern
;; variables (?var, !var, q) clj-kondo's static analysis can't resolve
;; as ordinary symbols. Exclude their pattern-matching forms from the
;; unresolved-symbol linter so the CLJS verifiers lint cleanly. The
;; forms themselves still get arity + namespace lint checks.
;;
;; Additionally, the `.forge-version.edn` files scaffold-generated by
;; neurosym-forge are JSON-shaped (string keys), not strictly EDN — skip
;; them from EDN linting until the scaffold emits proper EDN.
;;
;; Several pre-existing warnings in legacy CLJS code (redundant let,
;; redefined-var, unused-namespace) are downgraded to :info so they don't
;; fail the gate. Fix them incrementally; CI gates on errors only.
{:linters
 {:unresolved-symbol
  {:exclude
   [(meander.epsilon/search)
    (meander.epsilon/match)
    (meander.epsilon/find)
    (meander.epsilon/rewrite)
    (meander.epsilon/rewrites)
    (meander.epsilon/breadth-first)
    (meander.epsilon/zeta)
    (clojure.core.logic/run)
    (clojure.core.logic/run*)
    (clojure.core.logic/fresh)]}
  :unused-namespace      {:level :info}
  :redefined-var         {:level :info}
  :redundant-let         {:level :info}
  :redundant-do          {:level :info}
  :misplaced-docstring   {:level :info}
  :unused-value          {:level :info}}

 :output
 {:exclude-files [".*\\.forge-version\\.edn$"]}}
