# import-linter contract for NFR-4: no direct HTTP outside scrapling-fetch.
#
# source_modules is empty by necessity, NOT as the enforcement mechanism.  All
# skill code lives under skills/<name>/scripts/, where the top-level package name
# "scripts" is not unique and is not resolvable by import-linter from the repo
# root without per-skill PYTHONPATH juggling, so import-linter cannot walk the
# real graph here.
#
# ACTUAL ENFORCEMENT lives in ci/lint_no_direct_http.py, which AST-scans every
# skill's source tree and fails on any forbidden HTTP/browser import outside
# scrapling-fetch (with an explicit, enumerated allowlist for book-compose's
# local file:/// PDF rendering).  Run it via `python -m ci.lint_no_direct_http`;
# it is exercised by ci/test_lint_no_direct_http.py against the real tree.
#
# This INI is retained as documentation of the forbidden module list and as a
# wiring point if skills are ever refactored to publish as proper top-level
# packages (namespace packages or an editable install at the repo root), at
# which point the resulting package names can be added to source_modules.

[importlinter]
root_packages =
    # (empty until Phase 4 — see comment above)

[importlinter:contract:no-direct-http-outside-scrapling-fetch]
name = No direct HTTP outside scrapling-fetch
type = forbidden
source_modules =
    # (empty until Phase 4 — see comment above)
    # Future entries:
    #   syntopical_metabook
    #   book_knowledge
    #   book_thesis
    #   russellian_style
    #   book_compose
    #   book_review
    #   book_qa
forbidden_modules =
    requests
    httpx
    urllib3
    aiohttp
    playwright
