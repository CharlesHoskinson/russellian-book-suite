    <https://example.org/book-knowledge/claims/clm-2026-000001> a prov:Entity,
            tbf:Claim ;
        prov:wasDerivedFrom <https://example.org/book-knowledge/sources/thesis#thesis%3Astatement> ;
        tbf:confidence 0.9 ;
        tbf:hasSourceSpan <https://example.org/book-knowledge/sources/thesis#thesis%3Astatement> ;
        tbf:pPosterior 0.7 ;
        tbf:status "verified" ;
        schema:dateCreated "2026-05-12T16:13:51.630442+00:00"^^xsd:dateTime ;
        schema:text """Contemporary Bermuda is a self-governing British Overseas Territory whose
economy, society, and institutions are shaped by two persistent forces:
its geography (an isolated mid-Atlantic island chain with no arable scale
and a reef shelter that produced the early salvage and salt economies)
and its history (slavery, the 1834 emancipation, and the 1968
constitutional settlement that put a Black-majority population in
political control of an internationally-exposed financial centre)."""^^xsd:string .

    <https://example.org/book-knowledge/claims/clm-2026-000004> a prov:Entity,
            tbf:Claim ;
        prov:wasDerivedFrom <https://example.org/book-knowledge/sources/thesis#sub_arguments/demographics-and-c> ;
        tbf:confidence 0.85 ;
        tbf:hasSourceSpan <https://example.org/book-knowledge/sources/thesis#sub_arguments/demographics-and-c> ;
        tbf:pPosterior 0.7 ;
        tbf:status "verified" ;
        tbf:supportsChapter <https://example.org/book-knowledge/chapters/ch-05> ;
        schema:dateCreated "2026-05-12T16:13:51.630442+00:00"^^xsd:dateTime ;
        schema:text "Bermuda's demographic structure — Black majority since the nineteenth century, Portuguese-Bermudian minority, declining fertility — produced the cultural institutions (AME church, Cup Match, Gombey troupes) that define contemporary Bermudian life."^^xsd:string .

    <https://example.org/book-knowledge/claims/clm-2026-000005> a prov:Entity,
            tbf:Claim ;
        prov:wasDerivedFrom <https://example.org/book-knowledge/sources/thesis#sub_arguments/cost-of-living> ;
        tbf:confidence 0.85 ;
        tbf:hasSourceSpan <https://example.org/book-knowledge/sources/thesis#sub_arguments/cost-of-living> ;
        tbf:pPosterior 0.7 ;
        tbf:status "verified" ;
        tbf:supportsChapter <https://example.org/book-knowledge/chapters/ch-06> ;
        schema:dateCreated "2026-05-12T16:13:51.630442+00:00"^^xsd:dateTime ;
        schema:text "The same geography that produced the economy also produces the cost structure: import-everything supply chains, expensive housing, and utilities pricing that explain why a single resident's monthly outlay exceeds OECD medians by roughly three times."^^xsd:string .

    <https://example.org/book-knowledge/claims/clm-2026-000006> a prov:Entity,
            tbf:Claim ;
        prov:wasDerivedFrom <https://example.org/book-knowledge/sources/thesis#sub_arguments/who-can-live-there> ;
        tbf:confidence 0.85 ;
        tbf:hasSourceSpan <https://example.org/book-knowledge/sources/thesis#sub_arguments/who-can-live-there> ;
        tbf:pPosterior 0.7 ;
        tbf:status "verified" ;
        tbf:supportsChapter <https://example.org/book-knowledge/chapters/ch-07> ;
        schema:dateCreated "2026-05-12T16:13:51.630442+00:00"^^xsd:dateTime ;
        schema:text "The Bermudian-status / Permanent Resident Certificate / work-permit framework determines who may live and work on the islands, and that framework is shaped by the same labour-market pressures the rest of the book traces."^^xsd:string .

    <https://example.org/book-knowledge/claims/clm-2026-000008> a prov:Entity,
            tbf:Claim ;
        prov:wasDerivedFrom <https://example.org/book-knowledge/sources/thesis#invariants/parish-count> ;
        tbf:confidence 0.95 ;
        tbf:hasSourceSpan <https://example.org/book-knowledge/sources/thesis#invariants/parish-count> ;
        tbf:pPosterior 0.7 ;
        tbf:status "verified" ;
        schema:dateCreated "2026-05-12T16:13:51.630442+00:00"^^xsd:dateTime ;
        schema:text """Bermuda has nine traditional parishes including St. George's. Any chapter
that names a different count contradicts the manual's canonical fact."""^^xsd:string .

    <https://example.org/book-knowledge/claims/clm-2026-000009> a prov:Entity,
            tbf:Claim ;
        prov:wasDerivedFrom <https://example.org/book-knowledge/sources/thesis#invariants/bmd-peg> ;
        tbf:confidence 0.95 ;
        tbf:hasSourceSpan <https://example.org/book-knowledge/sources/thesis#invariants/bmd-peg> ;
