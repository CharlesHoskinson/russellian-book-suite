{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book-manifest",
  "type": "object",
  "required": ["book_id", "title", "version", "built_at", "chapters_included",
               "outputs", "total_word_count", "total_claim_count"],
  "properties": {
    "book_id":            {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title":              {"type": "string", "minLength": 1},
    "version":            {"type": "string", "minLength": 1},
    "built_at":           {"type": "string", "format": "date-time"},
    "chapters_included":  {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "chapter_versions":   {"type": "object", "additionalProperties": {"type": "string"}},
    "outputs":            {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "total_word_count":   {"type": "integer", "minimum": 0},
    "total_claim_count":  {"type": "integer", "minimum": 0},
    "shacl_conforms":     {"type": "boolean"},
    "competency_clean":   {"type": "boolean"},
    "sources_bibliography": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
