;; stale_after_source_refresh — verified claims whose source was refreshed AFTER
;; the claim was created (REQ-KG-006).
;;
;; Booklogic port of assets/queries/coverage/stale_after_source_refresh.rq:
;;   SELECT ?claim ?claim_date ?src_date WHERE {
;;     ?claim tbf:status "verified" ;
;;            schema:dateCreated ?claim_date ;
;;            prov:wasDerivedFrom ?src .
;;     ?src schema:dateCreated ?src_date .
;;     FILTER (?src_date > ?claim_date)
;;   }
;;
;; The :where binds a verified claim's id and created_at (schema:dateCreated),
;; then walks the claim->source derivation: a claim's source span carries the
;; source's doc_id (the natural key project_graph mints prov:wasDerivedFrom from),
;; so ?span joins the span back to the claim (claim-id) and its doc-id unifies
;; with the source row's id (?src) -- the relational form of
;; ``?claim prov:wasDerivedFrom ?src``. The source's ingested_at is the
;; schema:dateCreated of the RDF source URI.
;;
;; :filter applies the var-vs-var ordered comparison ``?src_date > ?claim_date``:
;; the source was ingested/refreshed strictly AFTER the claim was created, so the
;; claim may be stale against newer source material. Both are ISO-8601 strings,
;; which Cozo compares lexically -- the same total order the SPARQL date compare
;; uses. bermuda's golden is empty: its one manifest-backed claim was created at
;; the same instant the source was ingested (equal, not strictly later).
(defquery :stale-after-source-refresh
  :find   [?claim ?claim-date ?src-date]
  :where  [[?c :claim/id ?claim]
           [?c :claim/status "verified"]
           [?c :claim/created-at ?claim-date]
           [?span :source-span/claim-id ?claim]
           [?span :source-span/doc-id ?src]
           [?s :source/id ?src]
           [?s :source/ingested-at ?src-date]]
  :filter [[> ?src-date ?claim-date]])
