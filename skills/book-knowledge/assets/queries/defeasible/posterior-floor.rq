PREFIX tbf: <https://example.org/book-knowledge#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?claim ?p WHERE {
  ?claim a tbf:Claim ;
         tbf:pPosterior ?p ;
         tbf:supportsChapter ?chapter .
  FILTER (?p < 0.4)
  FILTER NOT EXISTS {
    ?claim tbf:pinLowConfidence true .
  }
}
