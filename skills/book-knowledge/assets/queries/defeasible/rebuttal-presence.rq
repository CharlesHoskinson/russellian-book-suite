PREFIX tbf: <https://example.org/book-knowledge#>
SELECT ?claim WHERE {
  ?claim a tbf:Claim ;
         tbf:loadBearing true ;
         tbf:supportsChapter ?chapter .
  FILTER NOT EXISTS {
    ?cc tbf:rebuts ?claim ;
        tbf:ccStatus "addressed" .
  }
  FILTER NOT EXISTS {
    ?claim tbf:axiom true .
  }
}
