@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix tbf:   <https://example.org/book-knowledge#> .

tbf:ClaimShape
    a sh:NodeShape ;
    sh:targetClass tbf:Claim ;
    sh:property [
        sh:path schema:text ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path tbf:status ;
        sh:minCount 1 ;
        sh:in ( "proposed" "verified" "disputed" "superseded" "refuted" ) ;
    ] ;
    sh:property [
        sh:path tbf:confidence ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
    ] ;
    sh:property [
        sh:path tbf:hasSourceSpan ;
        sh:minCount 1 ;
    ] ;
    sh:sparql [
        sh:message "Verified claims must derive from at least one source-span entity." ;
        sh:select """
          PREFIX tbf:  <https://example.org/book-knowledge#>
          PREFIX prov: <http://www.w3.org/ns/prov#>
          SELECT $this WHERE {
            $this tbf:status \"verified\" .
            FILTER NOT EXISTS { $this prov:wasDerivedFrom ?src . }
          }
        """ ;
    ] .

tbf:ChapterSectionShape
    a sh:NodeShape ;
    sh:targetClass tbf:ChapterSection ;
    sh:sparql [
        sh:message "Chapter sections must only cite verified claims." ;
        sh:select """
          PREFIX tbf:  <https://example.org/book-knowledge#>
          SELECT $this ?claim WHERE {
            $this tbf:usesClaim ?claim .
            ?claim tbf:status ?status .
            FILTER (?status != \"verified\")
          }
        """ ;
    ] .
