text_cardinality_present_0[focus] := *claim{id: focus, canonical_text: text}, !is_null(text)
?[focus_node, path_node, message] := *claim{id: focus}, not text_cardinality_present_0[focus], focus_node = focus, path_node = "https://schema.org/text", message = "Claim must have a canonical-text value (minCount 1)."