{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-report",
  "type": "object",
  "required": ["persona", "chapter_id", "verdict",
               "critical_count", "important_count", "minor_count", "reviewed_at"],
  "properties": {
    "persona":         {"type": "string"},
    "chapter_id":      {"type": "string", "pattern": "^ch-[0-9]{2,3}$"},
    "verdict":         {"enum": ["APPROVED", "APPROVED_WITH_NOTES", "NEEDS_WORK", "REJECT"]},
    "critical_count":  {"type": "integer", "minimum": 0},
    "important_count": {"type": "integer", "minimum": 0},
    "minor_count":     {"type": "integer", "minimum": 0},
    "reviewed_at":     {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
