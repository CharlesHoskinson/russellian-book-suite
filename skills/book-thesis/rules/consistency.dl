# rules/consistency.dl — pyDatalog rules for book-thesis Layer 4
#
# Loaded by scripts/datalog_consistency.py via pyDatalog.load. All terms used
# below are declared by the loader before this file is parsed; do not add new
# predicate names without updating the loader's create_terms call.
#
# Extensional (asserted by the loader):
#   is_thesis(N)            — N is the root thesis node.
#   sub_arg(N)              — N is a declared sub-argument.
#   paragraph(P)            — P is a paragraph or claim identifier.
#   supports(P, N)          — P declares it supports node N.
#   advances(Ch, N)         — chapter Ch advances sub-argument N.
#   requires_evidence(N, E) — node N declares evidence slot E.
#   claim(C)                — verified claim C exists in the ledger.
#   claim_subject(C, S)     — claim C is about subject S.
#   claim_value(C, V)       — claim C asserts value V.
#   claim_chapter(C, Ch)    — claim C supports chapter Ch.
#   conflict_decl(A, B)     — claim A declares conflict with claim B.
#   implies(A, B)           — claim A implies claim B (extension).
#   invariant_pin(I, S, V)  — invariant I pins subject S to value V.
#   invariant_forbid(I,S,V) — invariant I forbids subject S taking value V.
#
# Intensional (derived; queried by the loader):
#   states/3, reaches_thesis/1, orphan_paragraph/1,
#   direct_contradiction/2, transitive_contradiction/2,
#   sub_arg_no_chapter/1, missing_evidence/2,
#   unreachable_supports/1, declared_conflict/2, invariant_violation/2.

# A claim "states" subject=value when both attributes are present.
states(C, S, V) <= claim_subject(C, S) & claim_value(C, V)

# Transitive closure: a paragraph reaches the thesis through a chain of
# supports edges. Base case: directly supports a thesis-typed node.
reaches_thesis(P) <= supports(P, N) & is_thesis(N)
reaches_thesis(P) <= supports(P, N) & reaches_thesis(N)

# A paragraph that exists but cannot reach the thesis is orphaned.
orphan_paragraph(P) <= paragraph(P) & ~reaches_thesis(P)

# The supports edge points at a node nobody else recognises.
unreachable_supports(P) <= supports(P, N) & ~is_thesis(N) & ~sub_arg(N)

# Direct contradiction: two claims state the same subject with different values.
direct_contradiction(A, B) <= states(A, S, V1) & states(B, S, V2) & (V1 != V2)

# Author-declared conflict surfaces in the ledger's conflicts_with field.
declared_conflict(A, B) <= conflict_decl(A, B)
declared_conflict(A, B) <= conflict_decl(B, A)

# Transitive contradiction: A implies B and B contradicts some C.
transitive_contradiction(A, C) <= implies(A, B) & direct_contradiction(B, C)
transitive_contradiction(A, C) <= implies(A, B) & transitive_contradiction(B, C)
transitive_contradiction(A, C) <= direct_contradiction(A, C)

# A sub-argument advanced by no chapter. This is the chapter-coverage invariant
# (distinct from lint_supports' D12 paragraph-supports check); the loader emits
# it as a D11 invariant under the rule name sub_arg_no_chapter.
advanced(N) <= advances(Ch, N)
sub_arg_no_chapter(N) <= sub_arg(N) & ~advanced(N)

# An evidence slot named by a sub-argument but never met by a claim.
evidence_met(N, E) <= requires_evidence(N, E) & claim_subject(C, E)
missing_evidence(N, E) <= requires_evidence(N, E) & ~evidence_met(N, E)

# Author-declared invariants, compiled by compile_thesis from the `formal:`
# clause. invariant_pin(Inv, S, Vok): a claim about S must equal Vok; any other
# value violates Inv. invariant_forbid(Inv, S, Vbad): a claim about S must not
# equal Vbad.
invariant_violation(C, Inv) <= invariant_pin(Inv, S, Vok) & states(C, S, V) & (V != Vok)
invariant_violation(C, Inv) <= invariant_forbid(Inv, S, Vbad) & states(C, S, Vbad)
