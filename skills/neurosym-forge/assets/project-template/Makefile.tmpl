.PHONY: ci build extract smoke render clean

# REQ-PUB-044: default manuscript for `make render`. Override via
# `make render MANUSCRIPT=path/to/your.md` from the CLI.
MANUSCRIPT ?= fixtures/prose.md

ci: build extract smoke

build:
	npm install
	npm run build

extract:
	@if [ -f fixtures/claims_clean.jsonl ] && [ -f rules/predicates.edn ]; then \
	  python scripts/extract_preview.py \
	    --claims fixtures/claims_clean.jsonl \
	    --predicates rules/predicates.edn; \
	else \
	  echo "[extract] missing fixtures/claims_clean.jsonl or rules/predicates.edn; skipping"; \
	fi

smoke:
	@if [ -d tests ]; then pytest tests/ -v; else echo "[smoke] no tests/ directory; skipping"; fi

render:
	@if [ -f work/manuscript-annotations.json ]; then \
	  python scripts/render_annotations.py \
	    --source $(MANUSCRIPT) \
	    --annotations work/manuscript-annotations.json \
	    --out-dir work/render; \
	else \
	  echo "[render] missing work/manuscript-annotations.json; run verify first"; \
	fi

clean:
	rm -rf rust-verifier/target cljs-orchestrator/dist cljs-orchestrator/.shadow-cljs cljs-orchestrator/native
