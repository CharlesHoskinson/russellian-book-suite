{
  "version": "0.1.0+v2",
  "hedge_terms": [
    "might",
    "may",
    "could",
    "seems",
    "appears",
    "perhaps",
    "possibly",
    "generally",
    "often",
    "usually",
    "typically",
    "frequently",
    "sometimes",
    "somewhat",
    "rather",
    "quite",
    "fairly",
    "relatively",
    "arguably",
    "presumably",
    "supposedly",
    "ostensibly",
    "tend to",
    "tends to",
    "tended to",
    "in some cases",
    "in many cases",
    "for the most part",
    "should probably",
    "would likely",
    "could potentially"
  ],
  "passive_auxiliaries": [
    "be",
    "is",
    "am",
    "are",
    "was",
    "were",
    "been",
    "being"
  ],
  "modifier_budget_ratio": 0.25,
  "max_sentence_word_count": 30,
  "parallel_structure_anchors": [
    "imperative_verb",
    "gerund",
    "noun_phrase",
    "interrogative"
  ],
  "negative_trigger_keywords": [
    "marketing",
    "launch announcement",
    "pitch",
    "tagline",
    "fiction",
    "novel",
    "story",
    "poem",
    "casual",
    "slack message",
    "DM",
    "tweet",
    "persuasive essay",
    "op-ed"
  ],
  "listicle_patterns": [
    "rests on \\d+ premise",
    "rests on \\d+ premises",
    "rests on \\w+ premises",
    "consists of \\d+ component",
    "consists of \\w+ components",
    "has \\d+ elements",
    "has \\w+ elements",
    "the following \\d+",
    "the following \\w+ reasons",
    "in this chapter we (will )?(examine|cover|discuss|address) \\d+",
    "in this chapter we (will )?(examine|cover|discuss|address) \\w+ \\w+",
    "(\\d+) (key |main |central |core )?(premises|principles|reasons|points|themes|takeaways)"
  ],
  "listicle_anaphora_min_repeats": 3,
  "listicle_anaphora_window_lines": 6,
  "rhythm_run_min_length": 4,
  "rhythm_word_count_tolerance": 3,
  "ai_staccato": {
    "id": "ai_staccato",
    "tier": "important",
    "severity": "advisory",
    "detection": {
      "staccato_run_min": 3,
      "staccato_max_sentence_words": 12,
      "staccato_max_sentences_per_paragraph": 3,
      "negation_affirmation_min_paragraphs": 2,
      "this_is_window": 6,
      "this_is_min": 3,
      "abstract_subject_min_run": 4,
      "abstract_subject_stoplist": [
        "system",
        "protocol",
        "ledger",
        "truth",
        "freedom",
        "pipeline",
        "result",
        "process",
        "thing",
        "framework",
        "approach",
        "principle"
      ],
      "antithesis_closer_min": 3,
      "repeated_antithesis_min_count": 2
    }
  },
  "rhythm_drumbeat_exemption": true,
  "drumbeat_min_length_cv": 0.1,
  "drumbeat_max_pairwise_overlap": 0.6,
  "modifier_budget_by_register": {
    "technical-exposition": 0.2,
    "narrative-editorial": 0.3,
    "polemic": 0.25
  }
}