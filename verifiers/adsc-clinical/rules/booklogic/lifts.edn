;; rules/booklogic/lifts.edn — prose-to-atom extractors.
;;
;; FORM SYNTAX:
;;   (deflift name
;;     :from :claim/canonical-text
;;     :when "REGEX WITH (?P<v>capture-group)"
;;     :emit (fact ?claim-id SUBJECT :predicate-name (parse-float ?v)))
;;
;; The regex captures a value via a named group (Python `(?P<v>...)`); the
;; :emit form binds it as `?v` and produces a typed atom. Common :emit
;; coercions: (parse-float ?v), (parse-int ?v), or pass through as a string.
;;
;; EXAMPLE (commented out — uncomment and edit for your domain):
;; (deflift L001-molarity
;;   :from :claim/canonical-text
;;   :when "(?i)molarity\\s*(?:M\\s*)?(?:=|is|of)?\\s*(?P<v>[0-9]+(?:\\.[0-9]+)?)"
;;   :emit (fact ?claim-id :s :molarity (parse-float ?v)))
;;
;; COMMON SILENT FAILURES:
;;   - JS-style `(?<v>)` instead of Python-form `(?P<v>)` → the regex-compile
;;     gate in CI rejects this (also see Tier 2 follow-up to remove the
;;     silent JS-to-Python converter in ingest_ledger).
;;   - apostrophe in the source text (`van 't Hoff`) → the regex MUST allow
;;     both space and apostrophe in the gap: `van[' \\s]*t\\s*Hoff`, not
;;     `van['?]t` (zero-or-one) which fails on the two-char gap.
;;   - :emit referencing an undeclared predicate → nbb expand throws
;;     "deflift <name>: unknown predicate <pred>".
;;   - regex compiles but matches nothing → Phase A's extract gate
;;     surfaces this as a high OPAQUE fraction.
;;
{:forms
 [(deflift L001-trial-n
    :from :claim/canonical-text
    :when "(?i)\\bn\\s*=\\s*(?P<v>[0-9]+)"
    :emit (fact ?claim-id :t :trial-n (parse-int ?v)))

  (deflift L002-trial-p-value
    :from :claim/canonical-text
    :when "(?i)\\bp\\s*[<>=]\\s*(?P<v>0?\\.[0-9]+)"
    :emit (fact ?claim-id :t :trial-p-value (parse-float ?v)))

  (deflift L003-treatment-efficacy
    :from :claim/canonical-text
    :when "(?i)(?:efficacy|response\\s+rate|success\\s+rate|improvement)\\s*(?:was|of|=|at|reached)?\\s*(?P<v>[0-9]+(?:\\.[0-9]+)?)\\s*%"
    :emit (fact ?claim-id :tx :treatment-efficacy (parse-float ?v)))

  (deflift L004-follow-up-months
    :from :claim/canonical-text
    :when "(?i)(?:follow[- ]?up|followed\\s+for|tracked\\s+for)\\s*(?:was|of|for|at)?\\s*(?P<v>[0-9]+(?:\\.[0-9]+)?)\\s*months?"
    :emit (fact ?claim-id :t :follow-up-months (parse-float ?v)))

  (deflift L005-primary-endpoint-met
    :from :claim/canonical-text
    :when "(?i)primary\\s+endpoint\\s+(?P<v>met|achieved|reached|not\\s+met|missed|failed)"
    :emit (fact ?claim-id :t :primary-endpoint-met (parse-bool ?v)))

  (deflift L006-adverse-event-rate
    :from :claim/canonical-text
    :when "(?i)(?:adverse\\s+events?|side\\s+effects?|complications?)\\s*(?:rate|occurred\\s+in|in)?\\s*(?:was|=|of|at)?\\s*(?P<v>[0-9]+(?:\\.[0-9]+)?)\\s*%"
    :emit (fact ?claim-id :tx :adverse-event-rate (parse-float ?v)))

  (deflift L007-dose-mg
    :from :claim/canonical-text
    :when "(?i)\\bdose\\s*(?:of|=|was|at)?\\s*(?P<v>[0-9]+(?:\\.[0-9]+)?)\\s*mg\\b"
    :emit (fact ?claim-id :tx :dose-mg (parse-float ?v)))

  (deflift L008-patient-count
    :from :claim/canonical-text
    :when "(?i)(?P<v>[0-9]+)\\s+(?:patients|participants|subjects)\\b"
    :emit (fact ?claim-id :pop :patient-count (parse-int ?v)))]}
