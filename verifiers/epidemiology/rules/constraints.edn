{:version 1, :constraints [{:id "C001-herd-immunity", :backend :z3, :assert (approx= (+ (:vaccination-coverage ?p) 0.0) (:herd-immunity-threshold ?d) :tolerance 0.06), :tolerance 0.06, :track :claim/id, :on-unsat {:defect :D20, :severity :critical, :message "vaccination coverage below herd immunity threshold"}} {:id "C002-threshold-formula", :backend :z3, :assert (approx= (* (:herd-immunity-threshold ?d) (:basic-reproduction-number ?d)) (- (:basic-reproduction-number ?d) 1.0) :tolerance 0.05), :tolerance 0.05, :track :claim/id, :on-unsat {:defect :D21, :severity :critical, :message "herd-immunity threshold inconsistent with R0"}}]}
